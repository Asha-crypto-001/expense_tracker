/* Premium Dark Theme */

* {
    font-family: "Canva Sans", "IBM Plex Sans Arabic", "Noto Sans Variable", "Noto Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    color: #E2DFD8; /* Warm off-white */
}

QMainWindow, #contentArea {
    background-color: #1A1A18; /* Deep warm charcoal */
}

#dashboardScroll {
    background-color: transparent;
}

#dashboardTitle {
    color: #E2DFD8;
    font-size: 26px;
    font-weight: 700;
}

#dashboardCard {
    background-color: #20201D;
    border: 1px solid #2A2A26;
    border-radius: 10px;
    padding: 8px;
}

#dashboardLabel {
    color: #A09E96;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
}

#dashboardValue {
    color: #E2DFD8;
    font-size: 22px;
    font-weight: 700;
}

#dashboardMeta {
    color: #A09E96;
    font-size: 12px;
}

#sectionTitle {
    color: #E2DFD8;
    font-size: 16px;
    font-weight: 700;
    padding: 4px 0;
}

#insightCard {
    background-color: #24241F;
    border-left: 3px solid #D4AF37;
    color: #E2DFD8;
    padding: 12px 16px;
}

QProgressBar {
    background-color: #2A2A26;
    border: none;
    border-radius: 4px;
    color: #E2DFD8;
    text-align: center;
    height: 16px;
}

QProgressBar::chunk {
    background-color: #4DB6AC;
    border-radius: 4px;
}

QProgressBar#budgetWarning::chunk {
    background-color: #D4AF37;
}

QProgressBar#budgetExceeded::chunk {
    background-color: #E57373;
}

#sidebar {
    background-color: #141412;
    border-right: 1px solid #2A2A26;
}

#brandLabel {
    color: #D4AF37; /* Subtle gold/brass accent */
    font-weight: 700;
    font-size: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid #2A2A26;
}

#navButton {
    background-color: transparent;
    color: #A09E96;
    border: none;
    text-align: left;
    padding: 10px 15px;
    font-size: 14px;
    border-radius: 6px;
}

#navButton:hover {
    background-color: #232320;
    color: #E2DFD8;
}

#navButton:checked {
    background-color: #2A2A26;
    color: #E2DFD8;
    font-weight: bold;
}

/* Base Inputs */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #20201D;
    border: 1px solid #33332E;
    padding: 10px;
    border-radius: 4px;
    color: #E2DFD8;
    font-size: 14px;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #D4AF37;
    background-color: #232320;
}

/* Primary Button */
QPushButton#primaryButton {
    background-color: #D4AF37;
    color: #141412;
    border: none;
    padding: 12px;
    border-radius: 4px;
    font-weight: bold;
    font-size: 14px;
    min-height: 20px;
}

QPushButton#primaryButton:hover {
    background-color: #C39D2F;
}

QPushButton#primaryButton:pressed {
    background-color: #A78524;
}

/* Secondary Button */
QPushButton#secondaryButton {
    background-color: #2A2A26;
    color: #E2DFD8;
    border: 1px solid #33332E;
    padding: 10px;
    border-radius: 4px;
}

QPushButton#secondaryButton:hover {
    background-color: #33332E;
}

/* Cards */
QFrame#card {
    background-color: #20201D;
    border: 1px solid #2A2A26;
    border-radius: 8px;
}

QLabel#h1 {
    font-size: 24px;
    font-weight: bold;
    color: #E2DFD8;
}

QLabel#h2 {
    font-size: 18px;
    font-weight: bold;
    color: #E2DFD8;
}

QLabel#subtitle {
    font-size: 14px;
    color: #A09E96;
}

QLabel#journalDate {
    color: #A09E96;
    font-size: 14px;
}

QComboBox, QDateEdit, QTimeEdit, QSpinBox {
    min-height: 20px;
}

QLabel#h1, QLabel#h2, QLabel#subtitle, QLabel#dashboardTitle,
QLabel#dashboardMeta, QLabel#dashboardValue, QLabel#dashboardLabel {
    min-width: 0;
}
